# Copiar a .env.smtp.local en la raíz (ignorado por Git).
# Nunca añadir estas variables a VITE_ ni al frontend/Vercel.
DAYFLOW_SUPABASE_PROJECT_REF=spfrfvpexfnnhwpfinrq
SUPABASE_ACCESS_TOKEN=YOUR_SUPABASE_MANAGEMENT_TOKEN
DAYFLOW_SMTP_HOST=smtp.example.com
DAYFLOW_SMTP_PORT=587
DAYFLOW_SMTP_USER=YOUR_SMTP_USER
DAYFLOW_SMTP_PASS=YOUR_SMTP_PASSWORD
DAYFLOW_SMTP_FROM=no-reply@auth.example.com
DAYFLOW_SMTP_SENDER_NAME=Dayflow
# Ajustar a la cuota del proveedor y al tamaño de la beta.
DAYFLOW_AUTH_EMAILS_PER_HOUR=30
